# Orbit Environment Configuration Example
# Copy to .env or set environment variables accordingly.

# Optional: GitHub Personal Access Token to raise rate limit from 60 to 5,000 req/hr
# Basic public lookups function without this token.
GITHUB_TOKEN=

# Backend server host and port
ORBIT_HOST=0.0.0.0
ORBIT_PORT=8000

# Cache time-to-live in seconds (default: 300 = 5 minutes)
ORBIT_CACHE_TTL_SECONDS=300

# Request timeout for upstream GitHub API calls in seconds (default: 10)
ORBIT_HTTP_TIMEOUT_SECONDS=10.0

# CORS allowed origins (comma-separated, default: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173)
ORBIT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
